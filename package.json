{
  "name": "gui-cetz",
  "displayName": "GUI CeTZ",
  "description": "Edit CeTZ shapes in Draw.io while preserving Typst source and exact advanced SVG rendering.",
  "version": "0.1.0",
  "publisher": "tkrhsmt",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Visualization", "Other"],
  "extensionDependencies": ["hediet.vscode-drawio"],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      { "command": "cetzEditor.open", "title": "CeTZ: Open GUI Editor" },
      { "command": "cetzEditor.syncFromSource", "title": "CeTZ: Sync GUI From Typst" },
      { "command": "cetzEditor.insertShape", "title": "CeTZ: Insert Shape" }
    ],
    "menus": {
      "editor/context": [
        { "command": "cetzEditor.open", "when": "resourceExtname == .typ", "group": "navigation" },
        { "command": "cetzEditor.insertShape", "when": "resourceExtname == .typ", "group": "navigation" }
      ]
    }
  },
  "scripts": { "test": "node --test test/*.test.js" }
}
